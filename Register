            include 'connect.php';
 
            $msg            = '';
            $registriranKorisnik = false;
 
            if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['username'])) {
 
                $ime      = $_POST['ime'];
                $prezime  = $_POST['prezime'];
                $username = $_POST['username'];
                $lozinka  = $_POST['pass'];
                $lozinka2 = $_POST['passRep'];
 
                if ($lozinka !== $lozinka2) {
                    $msg = 'Passwords do not match!';
                } elseif (strlen($lozinka) < 4) {
                    $msg = 'Password must be at least 4 characters.';
                } else {
                    $hashed_password = password_hash($lozinka, PASSWORD_BCRYPT);
                    $razina = 0;
 
                    $sql  = "SELECT korisnicko_ime FROM korisnik WHERE korisnicko_ime = ?";
                    $stmt = mysqli_stmt_init($dbc);
                    if (mysqli_stmt_prepare($stmt, $sql)) {
                        mysqli_stmt_bind_param($stmt, 's', $username);
                        mysqli_stmt_execute($stmt);
                        mysqli_stmt_store_result($stmt);
                    }
 
                    if (mysqli_stmt_num_rows($stmt) > 0) {
                        $msg = 'Username already exists! Please choose another.';
                    } else {
                        $sql  = "INSERT INTO korisnik (ime, prezime, korisnicko_ime, lozinka, razina)
                                 VALUES (?, ?, ?, ?, ?)";
                        $stmt = mysqli_stmt_init($dbc);
                        if (mysqli_stmt_prepare($stmt, $sql)) {
                            mysqli_stmt_bind_param($stmt, 'ssssi',
                                $ime, $prezime, $username, $hashed_password, $razina);
                            mysqli_stmt_execute($stmt);
                            $registriranKorisnik = true;
                        }
                    }
                }
 
                mysqli_close($dbc);
            }
 
            if ($registriranKorisnik === true) {
                echo '<p class="success-msg">&#10003; User successfully registered!
                      <a href="admin.php">Log in</a></p>';
            } else {
