    $stmt = mysqli_stmt_init($dbc);
    if (mysqli_stmt_prepare($stmt, $sql)) {
        mysqli_stmt_bind_param($stmt, 'i', $id);
        mysqli_stmt_execute($stmt);
    }
}
 
if ($admin && isset($_POST['update'])) {
    $id       = (int)$_POST['id'];
    $title    = $_POST['title'];
    $about    = $_POST['about'];
    $content  = $_POST['content'];
    $category = $_POST['category'];
    $archive  = isset($_POST['archive']) ? 1 : 0;
 
    if (isset($_FILES['pphoto']) && $_FILES['pphoto']['error'] === 0) {
        $picture = basename($_FILES['pphoto']['name']);
        if (!is_dir('img')) mkdir('img', 0755, true);
        move_uploaded_file($_FILES['pphoto']['tmp_name'], 'img/' . $picture);
    } else {
        $picture = $_POST['existing_photo'];
    }
 
    $sql  = "UPDATE vijesti SET naslov=?, sazetak=?, tekst=?, slika=?, kategorija=?, arhiva=? WHERE id=?";
    $stmt = mysqli_stmt_init($dbc);
    if (mysqli_stmt_prepare($stmt, $sql)) {
        mysqli_stmt_bind_param($stmt, 'sssssii',
            $title, $about, $content, $picture, $category, $archive, $id);
        mysqli_stmt_execute($stmt);
    }
}
