        $uspjesnaPrijava = true;
        $_SESSION['username'] = $imeKorisnika;
        $_SESSION['level']    = $levelKorisnika;
        $admin = ($levelKorisnika == 1);
    } else {
        $uspjesnaPrijava = false;
    }
}
 
