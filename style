*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}
 
body {
    font-family: 'Georgia', 'Times New Roman', serif;
    background-color: #f0f0f0;
    color: #1a1a1a;
    font-size: 16px;
    line-height: 1.6;
}
 
a {
    text-decoration: none;
    color: inherit;
}
 
img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
}
 
ul {
    list-style: none;
}
 
header {
    background-color: #e10600;
    color: #ffffff;
}
 
.header-logo {
    background-color: #e10600;
    padding: 18px 40px 12px 40px;
}
 
.logo-text {
    font-family: 'Georgia', serif;
    font-size: 2.4rem;
    font-weight: bold;
    letter-spacing: -1px;
    color: #ffffff;
    text-transform: lowercase;
}
 
nav {
    background-color: #15151e;
    border-top: 1px solid #e10600;
}
 
nav ul {
    display: flex;
    align-items: center;
    padding: 0 40px;
}
 
nav ul li a {
    display: block;
    padding: 14px 20px;
    font-family: 'Arial', sans-serif;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 0.08em;
    color: #cccccc;
    text-transform: uppercase;
    transition: color 0.2s, background-color 0.2s;
}
 
nav ul li a:hover,
nav ul li a.active {
    color: #ffffff;
    background-color: #e10600;
}
 
main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px 20px;
}
 
section {
    margin-bottom: 50px;
}
 
section h2 {
    font-family: 'Arial Black', 'Arial', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 3px solid #1a1a1a;
    text-transform: uppercase;
}
 
.articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
}
 
article {
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
}
 
article img {
    transition: opacity 0.3s;
}
 
article:hover img {
    opacity: 0.88;
}
 
article h3 {
    font-family: 'Georgia', serif;
    font-size: 1.05rem;
    font-weight: bold;
    line-height: 1.35;
    color: #111111;
    padding: 16px 16px 8px 16px;
    transition: color 0.2s;
}
 
article h3 a:hover {
    color: #e10600;
}
 
article p {
    font-family: 'Georgia', serif;
    font-size: 0.875rem;
    color: #444444;
    line-height: 1.6;
    padding: 0 16px 12px 16px;
    flex-grow: 1;
}
 
article time {
    display: block;
    font-family: 'Arial', sans-serif;
    font-size: 0.78rem;
    color: #999999;
    padding: 8px 16px 16px 16px;
    border-top: 1px solid #eeeeee;
    margin-top: auto;
}
 
footer {
    background-color: #15151e;
    color: #ffffff;
    text-align: center;
    padding: 28px 40px;
}
 
.footer-logo {
    margin-bottom: 8px;
}
 
.footer-info {
    font-family: 'Arial', sans-serif;
    font-size: 0.82rem;
    color: #aaaaaa;
    margin-top: 6px;
}
 
main.article-page {
    background-color: #f0f0f0;
    max-width: 100%;
    padding: 0;
}
 
.article-page-wrapper {
    max-width: 700px;
    margin: 0 auto;
    padding: 32px 20px 60px 20px;
}
 
h2.article-category {
    font-family: 'Arial Black', 'Arial', sans-serif;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    text-transform: uppercase;
    padding-bottom: 12px;
    margin-bottom: 0;
    border-bottom: 3px solid #1a1a1a;
}
 
.article-card {
    background-color: #ffffff;
    padding: 30px 36px 40px 36px;
    border: 1px solid #e0e0e0;
}
 
.skripta-title {
    font-family: 'Georgia', serif;
    font-size: 1.4rem;
    font-weight: bold;
    color: #111111;
    text-transform: uppercase;
    margin-bottom: 10px;
    line-height: 1.3;
}
 
.skripta-meta {
    font-family: 'Arial', sans-serif;
    font-size: 0.82rem;
    color: #888888;
    margin-bottom: 4px;
}
 
.skripta-meta span {
    color: #555555;
}
 
.skripta-archive {
    font-family: 'Arial', sans-serif;
    font-size: 0.82rem;
    color: #e10600;
    margin-top: 6px;
}
 
.skripta-slika {
    margin: 20px 0;
}
 
.skripta-slika img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
}
 
.skripta-about {
    border-left: 3px solid #e10600;
    padding: 10px 16px;
    margin: 20px 0;
    background-color: #fdf0f0;
}
 
.skripta-about p {
    font-family: 'Georgia', serif;
    font-size: 0.95rem;
    color: #444444;
    font-style: italic;
    margin: 0;
}
 
.skripta-sadrzaj p {
    font-family: 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #333333;
    line-height: 1.8;
    margin-bottom: 16px;
}
 
.back-link {
    display: inline-block;
    margin-top: 24px;
    font-family: 'Arial', sans-serif;
    font-size: 0.82rem;
    font-weight: bold;
    color: #e10600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s;
}
 
.back-link:hover {
    color: #b30500;
}
 
.success-msg {
    background-color: #fdf0f0;
    border-left: 4px solid #e10600;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-family: 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #e10600;
}
 
.error-msg {
    background-color: #fdecea;
    border-left: 4px solid #c0392b;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-family: 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #c0392b;
}
 
.no-news {
    font-family: 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #888888;
    padding: 20px 0;
}
 
.bojaPoruke {
    font-family: 'Arial', sans-serif;
    font-size: 0.8rem;
    color: #c0392b;
}
 
.form-item {
    margin-bottom: 20px;
}
 
.form-item label {
    display: block;
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    color: #333333;
    margin-bottom: 6px;
}
 
.form-field {
    width: 100%;
}
 
.form-field-textual {
    width: 100%;
    padding: 9px 12px;
    font-family: 'Arial', sans-serif;
    font-size: 0.9rem;
    color: #222222;
    background-color: #fafafa;
    border: 1px solid #cccccc;
    border-radius: 2px;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
    resize: vertical;
}
 
.form-field-textual:focus {
    outline: none;
    border-color: #e10600;
    box-shadow: 0 0 0 2px rgba(225, 6, 0, 0.15);
    background-color: #ffffff;
}
 
select.form-field-textual {
    cursor: pointer;
    resize: none;
}
 
.form-item-checkbox {
    display: flex;
    align-items: center;
    gap: 12px;
}
 
.form-item-checkbox label {
    margin-bottom: 0;
}
 
.form-item-checkbox .form-field {
    width: auto;
}
 
.form-item-checkbox input[type="checkbox"] {
    width: 17px;
    height: 17px;
    cursor: pointer;
    accent-color: #e10600;
}
 
input[type="file"] {
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
    color: #555555;
    padding: 4px 0;
}
 
.form-item-buttons {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #eeeeee;
}
 
.btn-reset,
.btn-submit {
    padding: 10px 28px;
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
}
 
.btn-reset {
    background-color: #e0e0e0;
    color: #444444;
}
 
.btn-reset:hover {
    background-color: #cccccc;
}
 
.btn-submit {
    background-color: #e10600;
    color: #ffffff;
}
 
.btn-submit:hover {
    background-color: #b30500;
}
 
.admin-entry {
    margin-bottom: 36px;
}
 
.admin-entry-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background-color: #15151e;
    color: #ffffff;
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
}
 
.admin-entry-id {
    font-weight: bold;
    color: #e10600;
    min-width: 30px;
}
 
.admin-entry-cat {
    margin-left: auto;
    background-color: #e10600;
    padding: 2px 10px;
    border-radius: 2px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
 
.admin-entry-archived {
    background-color: #c0392b;
    padding: 2px 10px;
    border-radius: 2px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
 
.admin-form {
    padding: 24px 30px 28px 30px;
}
 
.admin-photo-row {
    display: flex;
    align-items: center;
    gap: 16px;
}
 
.admin-photo-row img {
    width: 100px;
    height: 70px;
    object-fit: cover;
    border: 1px solid #dddddd;
}
 
.btn-delete {
    padding: 10px 28px;
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    background-color: #c0392b;
    color: #ffffff;
    transition: background-color 0.2s;
}
 
.btn-delete:hover {
    background-color: #992d22;
}
 
.admin-top-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
    flex-wrap: wrap;
}
 
.admin-top-bar h2 {
    margin-bottom: 0;
    flex: 1;
}
 
.admin-top-bar span {
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
    color: #555555;
}
 
.btn-logout {
    padding: 8px 18px;
    font-family: 'Arial', sans-serif;
    font-size: 0.82rem;
    font-weight: bold;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: #444444;
    color: #ffffff;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s;
    text-decoration: none;
    display: inline-block;
}
 
.btn-logout:hover {
    background-color: #222222;
    color: #ffffff;
}
 
.login-card {
    max-width: 480px;
    margin: 0 auto;
    padding: 32px 36px;
}
 
.tabs {
    display: flex;
    margin-bottom: 24px;
    border-bottom: 3px solid #15151e;
}
 
.tab-btn {
    font-family: 'Arial', sans-serif;
    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 12px 24px;
    color: #666666;
    background: #f0f0f0;
    border: 1px solid #dddddd;
    border-bottom: none;
    text-decoration: none;
    transition: background-color 0.2s, color 0.2s;
    margin-right: 4px;
}
 
.tab-btn:hover {
    background-color: #e0e0e0;
    color: #111111;
}
 
.tab-btn.active {
    background-color: #15151e;
    color: #ffffff;
    border-color: #15151e;
}
 
.controls {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    align-items: center;
}
 
.controls input,
.controls select {
    padding: 9px 12px;
    font-family: 'Arial', sans-serif;
    font-size: 0.88rem;
    border: 1px solid #cccccc;
    background: #fafafa;
    color: #222222;
    border-radius: 2px;
    box-sizing: border-box;
}
 
.controls input {
    flex: 1;
    min-width: 200px;
}
 
.controls select {
    min-width: 100px;
}
 
.controls input:focus,
.controls select:focus {
    outline: none;
    border-color: #e10600;
    box-shadow: 0 0 0 2px rgba(225, 6, 0, 0.15);
    background: #ffffff;
}
 
.stats-bar {
    font-family: 'Arial', sans-serif;
    font-size: 0.82rem;
    color: #888888;
    margin-bottom: 10px;
    padding: 6px 0;
}
 
.tbl-wrap {
    overflow-x: auto;
    border: 1px solid #e0e0e0;
}
 
.tbl-wrap table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
}
 
.tbl-wrap thead tr {
    background-color: #15151e;
    color: #ffffff;
}
 
.tbl-wrap thead th {
    padding: 12px 16px;
    text-align: left;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
}
 
.tbl-wrap tbody tr {
    border-bottom: 1px solid #eeeeee;
    background-color: #ffffff;
    transition: background-color 0.15s;
}
 
.tbl-wrap tbody tr:last-child {
    border-bottom: none;
}
 
.tbl-wrap tbody tr:hover {
    background-color: #fdf0f0;
}
 
.tbl-wrap tbody td {
    padding: 11px 16px;
    color: #222222;
    vertical-align: middle;
}
 
.tbl-wrap td.pos {
    font-weight: 900;
    color: #e10600;
    font-size: 1rem;
    width: 50px;
}
 
.tbl-wrap td.driver {
    font-weight: bold;
}
 
.tbl-wrap td.driver span {
    color: #aaaaaa;
    font-weight: normal;
    font-size: 0.78em;
    margin-left: 4px;
}
 
.tbl-wrap td.team {
    color: #666666;
}
 
.tbl-wrap td.pts {
    font-weight: bold;
    color: #15151e;
}
 
.tbl-wrap td.race {
    font-weight: bold;
}
 
.tbl-wrap tr.empty-row td {
    padding: 32px;
    text-align: center;
    color: #888888;
    font-style: italic;
}
 
.tbl-wrap td.status-fin {
    color: #2e7d32;
    font-weight: bold;
}
 
.tbl-wrap td.status-other {
    color: #b71c1c;
}
 
@media (max-width: 768px) {
    .articles-grid {
        grid-template-columns: 1fr;
    }
 
    nav ul {
        flex-wrap: wrap;
        padding: 0 10px;
    }
 
    nav ul li a {
        padding: 10px 14px;
        font-size: 0.75rem;
    }
 
    .header-logo {
        padding: 14px 20px;
    }
 
    main {
        padding: 24px 16px;
    }
}
 
@media (max-width: 1024px) and (min-width: 769px) {
    .articles-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

.wide-page-wrapper {
    max-width: 980px;
    margin: 0 auto;
    padding: 32px 20px 60px 20px;
}

.split-form {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 0;
}

.split-col-side {
    background-color: #fafafa;
    padding: 30px 28px;
    border-right: 1px solid #e0e0e0;
}

.split-col-main {
    padding: 30px 36px 40px 36px;
}

.split-col-side .form-item:last-of-type {
    margin-bottom: 0;
}

.split-form .form-item-buttons {
    grid-column: 1 / -1;
    padding: 20px 36px 30px 36px;
    margin-top: 0;
}

.image-preview-box {
    width: 100%;
    height: 160px;
    background-color: #eeeeee;
    border: 1px dashed #cccccc;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999999;
    font-family: 'Arial', sans-serif;
    font-size: 0.78rem;
    text-align: center;
    margin-bottom: 14px;
    overflow: hidden;
}

.image-preview-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

@media (max-width: 768px) {
    .split-form {
        grid-template-columns: 1fr;
    }
    .split-col-side {
        border-right: none;
        border-bottom: 1px solid #e0e0e0;
    }
    .split-form .form-item-buttons {
        padding: 20px 20px 0 20px;
    }
}

.admin-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: start;
}

.admin-article-list {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    overflow: hidden;
}

.admin-article-list-item {
    display: block;
    padding: 14px 16px;
    border-bottom: 1px solid #eeeeee;
    cursor: pointer;
    transition: background-color 0.15s;
}

.admin-article-list-item:last-child {
    border-bottom: none;
}

.admin-article-list-item:hover {
    background-color: #fdf0f0;
}

.admin-article-list-item.is-active {
    background-color: #15151e;
}

.admin-article-list-item.is-active .admin-list-title,
.admin-article-list-item.is-active .admin-list-meta {
    color: #ffffff;
}

.admin-list-id {
    font-family: 'Arial', sans-serif;
    font-size: 0.72rem;
    font-weight: bold;
    color: #e10600;
    margin-right: 6px;
}

.admin-list-title {
    font-family: 'Georgia', serif;
    font-size: 0.9rem;
    font-weight: bold;
    color: #222222;
    display: block;
    margin: 4px 0 4px 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.admin-list-meta {
    font-family: 'Arial', sans-serif;
    font-size: 0.72rem;
    color: #999999;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.admin-list-meta .archived-flag {
    color: #c0392b;
    font-weight: bold;
    margin-left: 6px;
}

.admin-edit-panel {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
}

.admin-edit-panel .admin-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 28px;
    padding: 28px 30px 30px 30px;
}

.admin-edit-panel .admin-form .form-item-full {
    grid-column: 1 / -1;
}

.admin-edit-panel .admin-form .form-item-buttons {
    grid-column: 1 / -1;
}

.admin-panel-heading {
    padding: 16px 24px;
    background-color: #15151e;
    color: #ffffff;
    font-family: 'Arial', sans-serif;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.admin-panel-heading .admin-entry-id {
    color: #e10600;
}

@media (max-width: 900px) {
    .admin-layout {
        grid-template-columns: 1fr;
    }
    .admin-edit-panel .admin-form {
        grid-template-columns: 1fr;
    }
}
