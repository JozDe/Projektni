<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F1 Stats</title>
    <link rel="stylesheet" type="text/css" href="style.css">
</head>
<body>
 
<?php
$tab    = isset($_GET['tab'])    ? $_GET['tab']            : 'standings';
$year   = isset($_GET['year'])   ? (int)$_GET['year']      : (int)date('Y');
$search = isset($_GET['search']) ? trim($_GET['search'])   : '';
 
$allowedTabs = ['standings', 'schedule', 'results'];
if (!in_array($tab, $allowedTabs)) {
    $tab = 'standings';
}
 
if ($year < 2010 || $year > (int)date('Y')) {
    $year = (int)date('Y');
}
 
$apiUrl = "F1api.php?type=$tab&year=$year";
 
$xmlString = @file_get_contents("http://" . $_SERVER['HTTP_HOST'] . dirname($_SERVER['PHP_SELF']) . "/" . $apiUrl);
 
$xml   = $xmlString ? @simplexml_load_string($xmlString) : false;
$error = '';
 
if ($xml === false) {
    $error = 'Could not load data from F1api.php. Check the file exists and allow_url_fopen is enabled.';
} elseif (isset($xml->status) && (string)$xml->status === 'error') {
    $error = (string)$xml->message;
}
?>
 
    <header>
        <div class="header-logo">
            <span class="logo-text">F1 Stats</span>
        </div>
        <nav>
            <ul>
                <li><a href="index.php" class="active">HOME</a></li>
                <li><a href="F1stats.php">STATS</a></li>
                <li><a href="administracija.php">ADMINISTRATION</a></li>
                <li><a href="Unos.php">ADD NEWS</a></li>
            </ul>
        </nav>
    </header>
 
    <main>
        <div style="max-width:1000px; margin:0 auto; padding:40px 20px;">
 
            <div class="tabs">
                <a class="tab-btn <?= $tab === 'standings' ? 'active' : '' ?>" href="?tab=standings">Driver Standings</a>
                <a class="tab-btn <?= $tab === 'schedule'  ? 'active' : '' ?>" href="?tab=schedule">Race Schedule</a>
                <a class="tab-btn <?= $tab === 'results'   ? 'active' : '' ?>" href="?tab=results">Race Results</a>
            </div>
 
            <?php if ($error): ?>
                <div class="error-msg">⚠ <?= htmlspecialchars($error) ?></div>
            <?php else: ?>
 
            <form method="GET" class="controls">
                <input type="hidden" name="tab" value="<?= htmlspecialchars($tab) ?>">
                <input type="text" name="search" placeholder="Search…" value="<?= htmlspecialchars($search) ?>">
                <select name="year">
                    <?php for ($y = (int)date('Y'); $y >= 2010; $y--): ?>
                        <option value="<?= $y ?>" <?= $y === $year ? 'selected' : '' ?>><?= $y ?></option>
                    <?php endfor; ?>
                </select>
                <button type="submit" class="btn-submit" style="padding:9px 20px;">Search</button>
            </form>
 
            <?php

            if ($tab === 'standings'):
 
                $drivers = [];
                foreach ($xml->standings->driver as $d) {
                    $name = $d->first_name . ' ' . $d->last_name;
                    $team = (string)$d->team;
                    if ($search !== '' && stripos($name, $search) === false && stripos($team, $search) === false) {
                        continue;
                    }
                    $drivers[] = $d;
                }
            ?>
                <div class="stats-bar">
                    <?= count($drivers) ?> driver<?= count($drivers) === 1 ? '' : 's' ?>
                    <?= $search !== '' ? ' matching "' . htmlspecialchars($search) . '"' : '' ?>
                    — Season <?= $year ?>
                </div>
 
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>POS</th>
                                <th>Driver</th>
                                <th>Team</th>
                                <th>PTS</th>
                                <th>Wins</th>
                                <th>Nationality</th>
                            </tr>
                        </thead>
                        <tbody>
                        <?php if (empty($drivers)): ?>
                            <tr class="empty-row"><td colspan="6">No drivers found.</td></tr>
                        <?php else: ?>
                            <?php foreach ($drivers as $d): ?>
                                <tr>
                                    <td class="pos"><?= htmlspecialchars($d->position) ?></td>
                                    <td class="driver">
                                        <?= htmlspecialchars($d->first_name . ' ' . $d->last_name) ?>
                                        <span style="color:#aaa;font-weight:normal;font-size:0.8em"><?= htmlspecialchars($d->code) ?></span>
                                    </td>
                                    <td class="team"><?= htmlspecialchars($d->team) ?></td>
                                    <td class="pts"><?= htmlspecialchars($d->points) ?></td>
                                    <td><?= htmlspecialchars($d->wins) ?></td>
                                    <td><?= htmlspecialchars($d->nationality) ?></td>
                                </tr>
                            <?php endforeach; ?>
                        <?php endif; ?>
                        </tbody>
                    </table>
                </div>
 
            <?php
            elseif ($tab === 'schedule'):
 
                $races = [];
                foreach ($xml->schedule->race as $r) {
                    $name    = (string)$r->name;
                    $circuit = (string)$r->circuit;
                    if ($search !== '' && stripos($name, $search) === false && stripos($circuit, $search) === false) {
                        continue;
                    }
                    $races[] = $r;
                }
            ?>
                <div class="stats-bar">
                    <?= count($races) ?> race<?= count($races) === 1 ? '' : 's' ?>
                    <?= $search !== '' ? ' matching "' . htmlspecialchars($search) . '"' : '' ?>
                    — Season <?= $year ?>
                </div>
 
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Round</th>
                                <th>Race</th>
                                <th>Circuit</th>
                                <th>Country</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                        <?php if (empty($races)): ?>
                            <tr class="empty-row"><td colspan="5">No races found.</td></tr>
                        <?php else: ?>
                            <?php foreach ($races as $r): ?>
                                <tr>
                                    <td class="pos"><?= htmlspecialchars($r->round) ?></td>
                                    <td class="race"><?= htmlspecialchars($r->name) ?></td>
                                    <td class="circuit"><?= htmlspecialchars($r->circuit) ?></td>
                                    <td><?= htmlspecialchars($r->country) ?></td>
                                    <td><?= htmlspecialchars($r->date) ?></td>
                                </tr>
                            <?php endforeach; ?>
                        <?php endif; ?>
                        </tbody>
                    </table>
                </div>
 
            <?php
            elseif ($tab === 'results'):
 
                $results = [];
                if (isset($xml->results->result)) {
                    foreach ($xml->results->result as $r) {
                        $name = $r->first_name . ' ' . $r->last_name;
                        $team = (string)$r->team;
                        if ($search !== '' && stripos($name, $search) === false && stripos($team, $search) === false) {
                            continue;
                        }
                        $results[] = $r;
                    }
                }
 
                $raceName = isset($xml->race) ? (string)$xml->race : '';
            ?>
                <div class="stats-bar">
                    <?= count($results) ?> driver<?= count($results) === 1 ? '' : 's' ?>
                    <?= $search !== '' ? ' matching "' . htmlspecialchars($search) . '"' : '' ?>
                    <?= $raceName !== '' ? ' — ' . htmlspecialchars($raceName) . ' (' . $year . ')' : '' ?>
                </div>
 
                <div class="tbl-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>POS</th>
                                <th>Driver</th>
                                <th>Team</th>
                                <th>Grid</th>
                                <th>Laps</th>
                                <th>PTS</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        <?php if (empty($results)): ?>
                            <tr class="empty-row"><td colspan="7">No results found.</td></tr>
                        <?php else: ?>
                            <?php foreach ($results as $r):
                                $status = (string)$r->status;
                                $statusClass = ($status === 'Finished' || strpos($status, '+') === 0) ? 'status-fin' : 'status-other';
                            ?>
                                <tr>
                                    <td class="pos"><?= htmlspecialchars($r->position) ?></td>
                                    <td class="driver">
                                        <?= htmlspecialchars($r->first_name . ' ' . $r->last_name) ?>
                                        <span style="color:#aaa;font-weight:normal;font-size:0.8em"><?= htmlspecialchars($r->code) ?></span>
                                    </td>
                                    <td class="team"><?= htmlspecialchars($r->team) ?></td>
                                    <td><?= htmlspecialchars($r->grid) ?></td>
                                    <td><?= htmlspecialchars($r->laps) ?></td>
                                    <td class="pts"><?= htmlspecialchars($r->points) ?></td>
                                    <td class="<?= $statusClass ?>"><?= htmlspecialchars($status) ?></td>
                                </tr>
                            <?php endforeach; ?>
                        <?php endif; ?>
                        </tbody>
                    </table>
                </div>
 
            <?php endif; ?>
 
            <?php endif; ?>
 
        </div>
    </main>
 
    <footer>
        <div class="footer-logo">
            <span class="logo-text">F1</span>
        </div>
        <p class="footer-info">F1 Stats <?= date('Y') ?></p>
    </footer>
 
</body>
</html>
