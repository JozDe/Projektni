    <script>
    
    const state = {
        standings: { data: [], sortCol: 'position', sortDir: 1 },
        schedule:  { data: [], sortCol: 'round',    sortDir: 1 },
        results:   { data: [], sortCol: 'position', sortDir: 1, raceName: '' },
    };
 
    function switchTab(name, btn) {
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('tab-' + name).classList.add('active');
        btn.classList.add('active');
        hideError();
    }
 
    async function fetchXML(url) {
        const res = await fetch(url);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const text = await res.text();
        return new DOMParser().parseFromString(text, 'application/xml');
    }
 
    function xmlText(node, tag) {
        const el = node.querySelector(tag);
        return el ? el.textContent.trim() : '';
    }
 
    async function loadStandings() {
        const year = document.getElementById('standingsYear').value;
        setLoading('standingsTbody', 6);
        hideError();
        try {
            const doc  = await fetchXML(`f1api.php?type=standings&year=${year}`);
            const nodes = doc.querySelectorAll('driver');
            state.standings.data = Array.from(nodes).map(n => ({
                position:    +xmlText(n, 'position'),
                driver:      xmlText(n, 'first_name') + ' ' + xmlText(n, 'last_name'),
                code:        xmlText(n, 'code'),
                team:        xmlText(n, 'team'),
                points:      +xmlText(n, 'points'),
                wins:        +xmlText(n, 'wins'),
                nationality: xmlText(n, 'nationality'),
            }));
            filterStandings();
        } catch(e) {
            showError('Could not load standings. ' + e.message);
            setEmpty('standingsTbody', 6);
        }
    }
 
    function filterStandings() {
        const q = document.getElementById('standingsSearch').value.toLowerCase();
        let rows = state.standings.data.filter(r =>
            !q || r.driver.toLowerCase().includes(q) || r.team.toLowerCase().includes(q) || r.nationality.toLowerCase().includes(q)
        );
        rows = applySort(rows, state.standings);
        document.getElementById('standingsBar').textContent =
            rows.length + ' driver' + (rows.length !== 1 ? 's' : '') +
            (rows.length !== state.standings.data.length ? ' (filtered from ' + state.standings.data.length + ')' : '');
        const tbody = document.getElementById('standingsTbody');
        if (!rows.length) { setEmpty('standingsTbody', 6); return; }
        tbody.innerHTML = rows.map(r => {
            const medal = r.position === 1 ? 'medal-1' : r.position === 2 ? 'medal-2' : r.position === 3 ? 'medal-3' : '';
            return `<tr>
                <td class="pos ${medal}">${r.position}</td>
                <td class="driver">${esc(r.driver)} <span style="color:#aaa;font-weight:normal;font-size:0.8em">${esc(r.code)}</span></td>
                <td class="team">${esc(r.team)}</td>
                <td class="pts">${r.points}</td>
                <td>${r.wins}</td>
                <td>${esc(r.nationality)}</td>
            </tr>`;
        }).join('');
    }
 
    async function loadSchedule() {
        const year = document.getElementById('scheduleYear').value;
        setLoading('scheduleTbody', 6);
        hideError();
        try {
            const doc   = await fetchXML(`f1api.php?type=schedule&year=${year}`);
            const nodes = doc.querySelectorAll('race');
            state.schedule.data = Array.from(nodes).map(n => ({
                round:   +xmlText(n, 'round'),
                name:    xmlText(n, 'name'),
                circuit: xmlText(n, 'circuit'),
                country: xmlText(n, 'country'),
                date:    xmlText(n, 'date'),
                sprint:  xmlText(n, 'sprint_date'),
            }));
            filterSchedule();
        } catch(e) {
            showError('Could not load schedule. ' + e.message);
            setEmpty('scheduleTbody', 6);
        }
    }
 
    function filterSchedule() {
        const q = document.getElementById('scheduleSearch').value.toLowerCase();
        const today = new Date().toISOString().slice(0,10);
        let rows = state.schedule.data.filter(r =>
            !q || r.name.toLowerCase().includes(q) || r.circuit.toLowerCase().includes(q) || r.country.toLowerCase().includes(q)
        );
        rows = applySort(rows, state.schedule);
        document.getElementById('scheduleBar').textContent =
            rows.length + ' race' + (rows.length !== 1 ? 's' : '') +
            (rows.length !== state.schedule.data.length ? ' (filtered from ' + state.schedule.data.length + ')' : '');
        const tbody = document.getElementById('scheduleTbody');
        if (!rows.length) { setEmpty('scheduleTbody', 6); return; }
        tbody.innerHTML = rows.map(r => {
            const isPast   = r.date && r.date < today;
            const isNext   = !isPast && rows.find(x => x.date >= today)?.round === r.round;
            const rowStyle = isNext ? 'background:#fdf0f0;' : '';
            const dateStr  = r.date ? formatDate(r.date) : 'TBA';
            return `<tr style="${rowStyle}">
                <td class="pos">${r.round}</td>
                <td class="race">${esc(r.name)}${isNext ? ' <span style="color:#e10600;font-size:0.75em">▶ NEXT</span>' : ''}</td>
                <td class="circuit">${esc(r.circuit)}</td>
                <td>${esc(r.country)}</td>
                <td style="color:${isPast ? '#aaa' : '#222'}">${dateStr}</td>
                <td style="color:#888;font-size:0.82em">${r.sprint ? formatDate(r.sprint) : '—'}</td>
            </tr>`;
        }).join('');
    }
 
    async function loadRounds() {
        const year = document.getElementById('resultsYear').value;
        try {
            const doc   = await fetchXML(`f1api.php?type=schedule&year=${year}`);
            const nodes = doc.querySelectorAll('race');
            const sel   = document.getElementById('resultsRound');
            sel.innerHTML = '<option value="last">Last race</option>';
            Array.from(nodes).forEach(n => {
                const round = xmlText(n, 'round');
                const name  = xmlText(n, 'name');
                const opt   = document.createElement('option');
                opt.value       = round;
                opt.textContent = 'Round ' + round + ' — ' + name;
                sel.appendChild(opt);
            });
        } catch(e) { /* keep default */ }
        loadResults();
    }
 
    async function loadResults() {
        const year  = document.getElementById('resultsYear').value;
        const round = document.getElementById('resultsRound').value;
        const path  = round === 'last'
            ? `f1api.php?type=results&year=${year}`
            : `f1api.php?type=results&year=${year}&round=${round}`;
        setLoading('resultsTbody', 8);
        hideError();
        try {
            const doc   = await fetchXML(path);
            state.results.raceName = xmlText(doc.documentElement, 'race') + ' ' + xmlText(doc.documentElement, 'season');
            const nodes = doc.querySelectorAll('result');
            state.results.data = Array.from(nodes).map(n => ({
                position:    +xmlText(n, 'position'),
                driver:      xmlText(n, 'first_name') + ' ' + xmlText(n, 'last_name'),
                code:        xmlText(n, 'code'),
                team:        xmlText(n, 'team'),
                grid:        +xmlText(n, 'grid'),
                laps:        +xmlText(n, 'laps'),
                points:      +xmlText(n, 'points'),
                status:      xmlText(n, 'status'),
                fl_time:     xmlText(n, 'fastest_lap time') || xmlText(n, 'time'),
                fl_rank:     xmlText(n, 'fastest_lap rank') || xmlText(n, 'rank'),
            }));
            filterResults();
        } catch(e) {
            showError('Could not load results. ' + e.message);
            setEmpty('resultsTbody', 8);
        }
    }
 
    function filterResults() {
        const q = document.getElementById('resultsSearch').value.toLowerCase();
        let rows = state.results.data.filter(r =>
            !q || r.driver.toLowerCase().includes(q) || r.team.toLowerCase().includes(q) || r.status.toLowerCase().includes(q)
        );
        rows = applySort(rows, state.results);
        const label = state.results.raceName ? ' — ' + state.results.raceName : '';
        document.getElementById('resultsBar').textContent =
            rows.length + ' driver' + (rows.length !== 1 ? 's' : '') + label +
            (rows.length !== state.results.data.length ? ' (filtered from ' + state.results.data.length + ')' : '');
        const tbody = document.getElementById('resultsTbody');
        if (!rows.length) { setEmpty('resultsTbody', 8); return; }
        tbody.innerHTML = rows.map(r => {
            const medal   = r.position === 1 ? 'medal-1' : r.position === 2 ? 'medal-2' : r.position === 3 ? 'medal-3' : '';
            const finCls  = r.status === 'Finished' || r.status.startsWith('+') ? 'status-fin' : 'status-other';
            const flBadge = r.fl_rank === '1'
                ? `<span style="color:#e10600;font-weight:bold">${esc(r.fl_time)}</span>`
                : (r.fl_time ? esc(r.fl_time) : '—');
            return `<tr>
                <td class="pos ${medal}">${r.position}</td>
                <td class="driver">${esc(r.driver)} <span style="color:#aaa;font-weight:normal;font-size:0.8em">${esc(r.code)}</span></td>
                <td class="team">${esc(r.team)}</td>
                <td>${r.grid}</td>
                <td>${r.laps}</td>
                <td class="pts">${r.points}</td>
                <td class="${finCls}">${esc(r.status)}</td>
                <td style="font-size:0.82em">${flBadge}</td>
            </tr>`;
        }).join('');
    }
 
    function sortTable(tab, col) {
        const s = state[tab];
        s.sortDir = (s.sortCol === col) ? s.sortDir * -1 : 1;
        s.sortCol = col;
        document.querySelectorAll(`#tab-${tab} thead th`).forEach(th => th.classList.remove('sorted'));
        const prefix = tab === 'standings' ? 'sth-' : tab === 'schedule' ? 'scth-' : 'rth-';
        const th = document.getElementById(prefix + col);
        if (th) th.classList.add('sorted');
        if (tab === 'standings') filterStandings();
        else if (tab === 'schedule') filterSchedule();
        else filterResults();
    }
 
    function applySort(rows, s) {
        return rows.slice().sort((a, b) => {
            let va = a[s.sortCol] ?? '', vb = b[s.sortCol] ?? '';
            if (typeof va === 'number') return (va - vb) * s.sortDir;
            return va.toString().localeCompare(vb.toString()) * s.sortDir;
        });
    }
 
    function setLoading(id, cols) {
        document.getElementById(id).innerHTML =
            `<tr class="loading-row"><td colspan="${cols}">Loading…</td></tr>`;
    }
 
    function setEmpty(id, cols) {
        document.getElementById(id).innerHTML =
            `<tr class="empty-row"><td colspan="${cols}">No data found.</td></tr>`;
    }
 
    function showError(msg) {
        const el = document.getElementById('errorBanner');
        el.textContent = '⚠ ' + msg;
        el.style.display = 'block';
    }
 
    function hideError() {
        document.getElementById('errorBanner').style.display = 'none';
    }
 
    function esc(str) {
        return String(str || '')
            .replace(/&/g,'&amp;').replace(/</g,'&lt;')
            .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
 
    function formatDate(iso) {
        if (!iso) return '';
        const [y, m, d] = iso.split('-');
        const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        return `${+d} ${months[+m-1]} ${y}`;
    }
 
    loadStandings();
    loadSchedule();
    loadRounds();
    </script>
 
