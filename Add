            if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['title'])) {
                include 'connect.php';
 
                $title    = $_POST['title'];
                $about    = $_POST['about'];
                $content  = $_POST['content'];
                $category = $_POST['category'];
                $date     = date('d.m.Y.');
                $archive  = isset($_POST['archive']) ? 1 : 0;
 
                $picture = '';
                if (isset($_FILES['pphoto']) && $_FILES['pphoto']['error'] === 0) {
                    $picture    = basename($_FILES['pphoto']['name']);
                    $target_dir = 'img/' . $picture;
                    if (!is_dir('img')) {
                        mkdir('img', 0755, true);
                    }
                    move_uploaded_file($_FILES['pphoto']['tmp_name'], $target_dir);
                }
 
                $sql  = "INSERT INTO vijesti (datum, naslov, sazetak, tekst, kategorija, slika, arhiva)
                         VALUES (?, ?, ?, ?, ?, ?, ?)";
                $stmt = mysqli_stmt_init($dbc);
                if (mysqli_stmt_prepare($stmt, $sql)) {
                    mysqli_stmt_bind_param($stmt, 'ssssssi', $date, $title, $about, $content, $category, $picture, $archive);
                    mysqli_stmt_execute($stmt) or die('Database error: ' . mysqli_stmt_error($stmt));
                } else {
                    die('Database error: ' . mysqli_error($dbc));
                }
 
                mysqli_close($dbc);
 
                echo '<p class="success-msg" style="margin:24px 30px 0 30px;">&#10003; Article successfully saved! <a href="index.php">Back to home</a></p>';
            }
